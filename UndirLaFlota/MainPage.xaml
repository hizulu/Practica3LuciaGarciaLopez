<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="UndirLaFlota.MainPage"
             BackgroundColor="PaleTurquoise">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">
            <HorizontalStackLayout Spacing="20" HorizontalOptions="Center" Margin="0,10,0,20">
                <Label x:Name="LblDisparos" Text="Disparos: 0" FontSize="18" FontAttributes="Bold" VerticalOptions="Center" TextColor="DarkSlateGray"/>
                <Label x:Name="LblAciertos" Text="Aciertos: 0" FontSize="18" FontAttributes="Bold" VerticalOptions="Center" TextColor="DarkSlateGray"/>
                <Button Text="Nueva Partida" Clicked="OnNuevaPartidaClicked" BackgroundColor="DarkTurquoise" TextColor="DarkSlateGray"/>
            </HorizontalStackLayout>

            <Grid
                x:Name="TableroGrid"
                HorizontalOptions="Center"
                VerticalOptions="Center">
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <Label Grid.Row="1" Grid.Column="0" Text="A" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" TextColor="DarkSlateGray"/>
                <Label Grid.Row="2" Grid.Column="0" Text="B" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" TextColor="DarkSlateGray"/>
                <Label Grid.Row="3" Grid.Column="0" Text="C" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" TextColor="DarkSlateGray"/>
                <Label Grid.Row="4" Grid.Column="0" Text="D" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" TextColor="DarkSlateGray"/>
                <Label Grid.Row="5" Grid.Column="0" Text="E" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" TextColor="DarkSlateGray"/>
                <Label Grid.Row="6" Grid.Column="0" Text="F" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" TextColor="DarkSlateGray"/>
                <Label Grid.Row="7" Grid.Column="0" Text="G" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" TextColor="DarkSlateGray"/>
                <Label Grid.Row="8" Grid.Column="0" Text="H" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" TextColor="DarkSlateGray"/>
                <Label Grid.Row="9" Grid.Column="0" Text="I" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" TextColor="DarkSlateGray"/>
                <Label Grid.Row="10" Grid.Column="0" Text="J" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" TextColor="DarkSlateGray"/>

                <Label Grid.Column="1" Grid.Row="0" Text="1" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" TextColor="DarkSlateGray"/>
                <Label Grid.Column="2" Grid.Row="0" Text="2" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" TextColor="DarkSlateGray"/>
                <Label Grid.Column="3" Grid.Row="0" Text="3" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" TextColor="DarkSlateGray"/>
                <Label Grid.Column="4" Grid.Row="0" Text="4" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" TextColor="DarkSlateGray"/>
                <Label Grid.Column="5" Grid.Row="0" Text="5" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" TextColor="DarkSlateGray"/>
                <Label Grid.Column="6" Grid.Row="0" Text="6" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" TextColor="DarkSlateGray"/>
                <Label Grid.Column="7" Grid.Row="0" Text="7" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" TextColor="DarkSlateGray"/>
                <Label Grid.Column="8" Grid.Row="0" Text="8" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" TextColor="DarkSlateGray"/>
                <Label Grid.Column="9" Grid.Row="0" Text="9" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" TextColor="DarkSlateGray"/>
                <Label Grid.Column="10" Grid.Row="0" Text="10" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" TextColor="DarkSlateGray"/>
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
